{
  "name": "dsh-on-agentcore",
  "private": true,
  "type": "module",
  "description": "PoC: official DeepSeek Harness Web UI on Amazon Bedrock AgentCore Runtime (one runtime session per user)",
  "workspaces": [
    "packages/*",
    "services/*",
    "infra"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false && echo typecheck ok",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit --project property",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration",
    "build:adapter": "bash infra/scripts/build-adapter.sh",
    "synth": "npm run -w infra synth",
    "preflight": "npm run -w infra preflight --",
    "deploy": "npm run -w infra deploy --",
    "destroy": "npm run -w infra destroy --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "ws": "8.22.0"
  }
}
